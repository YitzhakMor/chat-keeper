{
  "name": "שומר השיחות",
  "short_name": "שומר השיחות",
  "description": "שמירה וצפייה בשיחות וואטסאפ, רק במכשיר שלך",
  "lang": "he",
  "dir": "rtl",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#efeae2",
  "theme_color": "#008069",
  "icons": [
    {"src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{"name": "files", "accept": ["application/zip", "application/x-zip-compressed", "text/plain", ".zip", ".txt"]}]
    }
  }
}
